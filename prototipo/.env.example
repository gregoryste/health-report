# Modelo do .env. Copie para .env e preencha. Este arquivo pode ser compartilhado (não tem segredos).

# Rota base da API (sem barra no final). Ex.: https://llm.interno.exemplo/v1
LLM_BASE_URL=

# Token de acesso (enviado como "Authorization: Bearer <token>")
LLM_TOKEN=

# Nome do modelo exposto pela API
LLM_MODEL=

# Formato da API: "openai" (rota /chat/completions) ou "ollama" (rota /api/chat)
LLM_API=openai

# --- Serviço do protótipo (etapa 6) ---
# Painel: contas individuais, criadas com  python -m app.usuarios criar  (não ficam no .env)
# Só para testes/teste_fluxo.py: uma conta de teste já criada
PAINEL_TESTE_LOGIN=
PAINEL_TESTE_SENHA=
SERVICO_API_KEY=
ORQUESTRADOR=interno
BASE_URL=http://localhost:8000
N8N_URL=http://localhost:5678
LLM_PAUSA=3
WHATSAPP_MODO=simulado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TELEFONE_TESTE=
WHATSAPP_WABA_ID=
WHATSAPP_IDIOMA=pt_BR
WHATSAPP_API_VERSAO=v25.0
WHATSAPP_MODELO_AVISO=
WHATSAPP_MODELO_LEMBRETE=
WHATSAPP_MODELO_CODIGO=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_NUMERO_CLINICA=
WHATSAPP_APP_ID=
# Um número por paciente fictício (opcional; quem não estiver aqui usa WHATSAPP_TELEFONE_TESTE)
# Ex.: WHATSAPP_TELEFONES=P03=+55 51 9xxxx-xxxx; P04=+55 51 9yyyy-yyyy
WHATSAPP_TELEFONES=
# 1 = botões interativos no WhatsApp; 0 = só texto
WHATSAPP_INTERATIVO=1
# Portal do paciente: 0 = desligado (atendimento pelo WhatsApp, D3 2ª revisão); 1 = religar
PORTAL_PACIENTE=0

# --- Opcionais (ambiente de teste / vídeo) ---
# LLM_FIXA=1 devolve respostas fixas, sem chamar a LLM
LLM_FIXA=0
# Caminhos alternativos do banco e do registro de aprovações (padrão: dados/prototipo.db e registros/aprovacoes.jsonl)
# BANCO=
# REGISTRO_APROVACOES=
