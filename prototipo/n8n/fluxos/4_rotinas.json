    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SERVICO_URL }}/api/rotinas",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{ $env.SERVICO_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ dias_simulados: ($json.body && $json.body.dias_simulados) || 0 }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "240481ed-0653-47c0-a820-8617e8b5a39c",
